// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inscription {
  id                String   @id @default(cuid())
  nom               String
  prenom            String
  sexe              String   @default("Non spécifié")
  dateNaissance     String
  heureNaissance    String?
  lieuNaissance     String
  lieuResidence     String
  religion          String
  telephone         String
  motDePasse        String   @default("")
  grade             String   @default("Explorateur")
  programme         String   @default("Initiation")
  statut            String   @default("En attente")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  uniqueLinks       UniqueLink[]
  payments          Payment[]
}

model UniqueLink {
  id                String   @id @default(cuid())
  inscriptionId     String
  token             String   @unique
  pdfPath           String
  isActive          Boolean  @default(true)
  expiresAt         DateTime
  downloadedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  inscription       Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
}

model Book {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  author            String
  description       String
  price             Float?
  isFree            Boolean  @default(false)
  category          String   @default("etu") // "etu" ou "recommended"
  imageUrl          String   @default("")
  whatsappMessage   String   @default("")
  driveUrl          String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Course {
  id                String   @id @default(cuid())
  title             String
  videoUrl          String
  shortDescription  String
  longDescription   String
  thumbnailUrl      String?
  order             Int      @default(0)
  published         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Payment {
  id                String   @id @default(cuid())
  inscriptionId     String
  type              String   // "INSCRIPTION" ou "MENSUEL"
  montant           Float    // 12000 pour inscription, 10000 pour mensuel
  estPaye           Boolean  @default(false)
  mois              Int?     // 1-12 (pour paiements mensuels)
  annee             Int?     // année (pour paiements mensuels)
  datePaiement      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inscription       Inscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@unique([inscriptionId, type, mois, annee])
  @@index([inscriptionId])
  @@index([estPaye])
}

model Membre {
  id                    String   @id @default(cuid())
  nom                   String
  prenoms               String
  nomSacre              String?
  profession            String?
  email                 String
  motDePasse            String?  // Hash bcrypt pour authentification dashboard
  dateNaissance         String
  heureNaissance        String?
  lieuNaissance         String
  religionPratique      String
  appartientAutreOrdre  Boolean  @default(false)
  precisionOrdre        String?
  grade                 String   @default("Explorateur") // Explorateur | Constructeur | Navigateur | Alchimiste
  equipage              String   @default("ALEPH") // ALEPH | BETH | GUIMEL
  telephoneWhatsapp     String
  lieuResidence         String
  statut                String   @default("actif") // actif | suspendu
  role                  String   @default("MEMBRE") // MEMBRE | ADMIN
  comiteProjets         Boolean  @default(false) // Accès au suivi des projets par nom sacré
  imageUrl              String?
  derniereConnexion     DateTime? // Première connexion si null
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  traversees            InscriptionTraversee[]
  tachesAssignees       Tache[]                @relation("TacheAssignee")

  @@index([statut])
  @@index([grade])
  @@index([nomSacre])
  @@index([role, statut])
  @@index([comiteProjets, statut])
}

model Traversee {
  id                  String   @id @default(cuid())
  type                String   @default("Traversée Grand Navire")
  titre               String
  description         String
  date                DateTime
  lieu                String
  lienUnique          String   @unique
  gradesAutorises     String[]
  serieId             String?
  activiteProgrammeId String?
  // Contenu de la séance, affiché sur la page publique
  instruction         String?
  seminaire           String?
  sujetPlanche        String?
  // Monographie proposée à l'inscription (instructions)
  monographieActive   Boolean  @default(false)
  monographiePrix     Int      @default(2000) // FCFA
  monographieImageUrl String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inscriptions     InscriptionTraversee[]
  enseignements    Enseignement[]
  activiteProgramme ActiviteProgramme? @relation(fields: [activiteProgrammeId], references: [id], onDelete: SetNull)

  @@index([lienUnique])
  @@index([serieId])
  @@index([activiteProgrammeId, date])
}

model InscriptionTraversee {
  id          String    @id @default(cuid())
  traverseeId String
  membreId    String
  presenceAt  DateTime?
  createdAt   DateTime  @default(now())

  traversee   Traversee @relation(fields: [traverseeId], references: [id], onDelete: Cascade)
  membre      Membre    @relation(fields: [membreId], references: [id], onDelete: Cascade)

  @@unique([traverseeId, membreId])
  @@index([traverseeId])
  @@index([membreId])
  @@index([presenceAt])
}

model ActiviteProgramme {
  id               String   @id @default(cuid())
  categorie        String
  titre            String
  description      String?
  heures           String
  lieu             String
  ordre            Int      @default(0)
  actif            Boolean  @default(true)
  catalogueDepuis  Int      @default(0)
  catalogueJusqua  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  programmations ProgrammationMensuelle[]
  evenements     Traversee[]

  @@unique([categorie, titre])
  @@index([categorie, actif])
}

model ProgrammationMensuelle {
  id          String   @id @default(cuid())
  activiteId  String
  annee       Int
  mois        Int
  jours       Int[]
  titre       String?
  description String?
  heures      String?
  lieu        String?
  ordre       Int?
  visible     Boolean  @default(true)
  specifique  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activite ActiviteProgramme @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  @@unique([activiteId, annee, mois])
  @@index([annee, mois])
}

// --- Comité de suivi des projets -------------------------------------------

model Projet {
  id          String   @id @default(cuid())
  titre       String
  resume      String?
  description String?
  statut      String   @default("en_cours") // propose | en_cours | termine | suspendu
  ordre       Int      @default(0)
  proposePar  String?  // nom sacré de l'auteur de la suggestion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taches       Tache[]
  commentaires Commentaire[]

  @@index([statut, ordre])
}

model Tache {
  id          String    @id @default(cuid())
  projetId    String
  titre       String
  description String?
  statut      String    @default("a_faire") // a_faire | en_cours | terminee | bloquee
  echeance    DateTime?
  assigneId   String?
  ordre       Int       @default(0)
  creePar     String?   // nom sacré de l'auteur
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projet       Projet        @relation(fields: [projetId], references: [id], onDelete: Cascade)
  assigne      Membre?       @relation("TacheAssignee", fields: [assigneId], references: [id], onDelete: SetNull)
  commentaires Commentaire[]

  @@index([projetId, ordre])
  @@index([assigneId])
  @@index([statut])
}

model Commentaire {
  id        String   @id @default(cuid())
  projetId  String?
  tacheId   String?
  auteur    String // nom sacré
  contenu   String
  createdAt DateTime @default(now())

  projet Projet? @relation(fields: [projetId], references: [id], onDelete: Cascade)
  tache  Tache?  @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([projetId, createdAt])
  @@index([tacheId, createdAt])
}

// --- Suivi des enseignements -----------------------------------------------
// Journal des thèmes enseignés. Date, activité et lieu sont recopiés pour que
// l'historique survive à la suppression du lien de l'événement.
model Enseignement {
  id          String   @id @default(cuid())
  traverseeId String?
  rubrique    String // instruction | seminaire | sujetPlanche
  theme       String
  date        DateTime
  activite    String
  lieu        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  traversee Traversee? @relation(fields: [traverseeId], references: [id], onDelete: SetNull)

  @@unique([traverseeId, rubrique])
  @@index([date])
  @@index([rubrique, date])
}
